# OpenWeatherMap (free tier: openweathermap.org)
OPENWEATHER_API_KEY=your_key_here

# Suno API (Docker container - see docker-compose.yml)
# Obtenha o cookie logando no suno.com e copiando o valor do cookie "session"
SUNO_COOKIE=your_suno_cookie_here
SUNO_API_URL=http://localhost:3000

# YouTube OAuth2
# 1. No Google Cloud Console: crie credenciais "OAuth 2.0 Client ID" (tipo: Desktop app)
# 2. Copie o Client ID e Client Secret abaixo
# 3. Execute: go run ./cmd/youtube-auth -client-id=... -client-secret=...
# 4. Cole o Refresh Token impresso no terminal
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
